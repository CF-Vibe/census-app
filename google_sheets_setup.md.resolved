# Google Sheets Integration Guide

To share and back up your census database across multiple devices using Google Sheets, you can set up a free Google Apps Script. 

This script is designed with a **dual-storage system**:
1. **Visual Sheet Rows**: It writes all resident information (Name, MyKad, Phone, Address, Age, Gender, State, Family Role) and campaign claims into standard spreadsheet columns so you can view, edit, or print them.
2. **Lossless JSON Sync**: It backs up the raw data in the background. This ensures that nested data structures (like campaign donation histories) are never lost during sync.

---

## Step-by-Step Setup

### Step 1: Create a Google Sheet
1. Open your Google Drive and create a new **Google Sheet**.
2. Name it something descriptive, like `Malaysia Census Database`.
3. Rename the first tab/sheet from `Sheet1` to `CensusData` (or leave it as default, the script will handle it).

### Step 2: Open the Apps Script Editor
1. In the Google Sheets menu, click **Extensions** -> **Apps Script**.
2. Delete any default code in the editor (`Code.gs`) and replace it with the code block below.

### Step 3: Paste the Apps Script Code
Copy and paste the following code:

```javascript
const SHEET_NAME = 'CensusData';
const HEADERS = [
  'Full Name / Nama Penuh / 姓名',
  'Phone / Telefon / 电话',
  'MyKad / ID Number',
  'Race / Bangsa / 种族',
  'Gender / Jantina / 性别',
  'Age / Umur / 年龄',
  'Birthdate / Tarikh Lahir / 出生日期',
  'State of Birth / Negeri Kelahiran / 出生州属',
  'Household Role / Peranan / 户口角色',
  'Family Head Name / Ketua Keluarga / 所属户主',
  'Address / Alamat / 住宅地址',
  'Aid Status / Status Bantuan / 领取状态',
  'Aid Item / Barang Sumbangan / 物资名称',
  'Claim Date / Masa Tuntutan / 领取时间',
  'Family Head ID Number',
  'Family Member ID Numbers',
  'Claim History / Sejarah Tuntutan / 领取记录'
];

function normalizePhone(p) {
  p = (p || '').toString().trim();
  if (/^0\d/.test(p)) return '+60' + p.substring(1);
  if (/^6\d{9,11}$/.test(p)) return '+60' + p;
  return p;
}

function normalizeRace(r) {
  r = (r || '').toString().trim();
  const key = r.split(' / ')[0].trim().toLowerCase();
  const map = { malay: 'Malay', chinese: 'Chinese', indian: 'Indian', others: 'Others' };
  return map[key] || r;
}

function doGet(e) {
  try {
    const sheet = getSheet();
    const data = sheet.getDataRange().getValues();
    const records = [];
    for (let i = 1; i < data.length; i++) {
      const row = data[i];
      if (!row[0] && !row[2]) continue;
      records.push({
        id: '',
        name: row[0] || '',
        phone: normalizePhone(row[1]),
        idNumber: row[2] || '',
        race: normalizeRace(row[3]),
        gender: row[4] || '',
        age: row[5] || '',
        birthdate: row[6] || '',
        state: row[7] || '',
        familyRole: (row[8] || 'head').toString().toLowerCase().includes('member') ? 'member' : 'head',
        familyHeadName: row[9] || '',
        address: row[10] || '',
        aidStatus: row[11] || '',
        aidItem: row[12] || '',
        claimDate: row[13] || '',
        familyHeadIdNumber: row[14] || '',
        familyMemberIdNumbers: row[15] || '',
        familyHeadId: '',
        donationHistory: [],
        claimHistory: (function() { try { return JSON.parse(row[16] || '{}'); } catch(err) { return {}; } })(),
        updatedAt: new Date().toISOString()
      });
    }
    records.push({
      id: 'METADATA_CAMPAIGNS',
      campaigns: [],
      activeCampaignId: '',
      deletedResidentIds: [],
      deletedCampaignIds: [],
      familyLinkages: []
    });
    return ContentService.createTextOutput(JSON.stringify(records)).setMimeType(ContentService.MimeType.JSON);
  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({ error: err.toString() })).setMimeType(ContentService.MimeType.JSON);
  }
}

function doPost(e) {
  try {
    const sheet = getSheet();
    const payload = JSON.parse(e.postData.contents);
    if (!Array.isArray(payload)) throw new Error('Expected array');
    const residents = payload.filter(r => r && r.idNumber && r.name);
    const allRows = [HEADERS];
    residents.forEach(r => {
      allRows.push([
        r.name || '', normalizePhone(r.phone), r.idNumber || '', normalizeRace(r.race), r.gender || '',
        r.age || '', r.birthdate || '', r.state || '', r.familyRole || 'head',
        r.familyHeadName || '', r.address || '', r.aidStatus || 'Unclaimed',
        r.aidItem || '', r.claimDate || '',
        r.familyHeadIdNumber || '',
        r.familyMemberIdNumbers || '',
        JSON.stringify(r.claimHistory || {})
      ]);
    });
    sheet.clearContents();
    sheet.getRange(1, 1, allRows.length, HEADERS.length).setValues(allRows);
    return ContentService.createTextOutput(JSON.stringify({ success: true, count: residents.length })).setMimeType(ContentService.MimeType.JSON);
  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({ error: err.toString() })).setMimeType(ContentService.MimeType.JSON);
  }
}

function getSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(SHEET_NAME);
  if (!sheet) {
    sheet = ss.insertSheet(SHEET_NAME);
    sheet.appendRow(HEADERS);
    return sheet;
  }
  const currentCols = sheet.getLastColumn();
  if (currentCols < HEADERS.length) {
    const fullHeader = HEADERS.slice();
    while (fullHeader.length < currentCols) fullHeader.unshift('');
    sheet.getRange(1, 1, 1, Math.max(currentCols, HEADERS.length)).setValues([fullHeader]);
    const lastRow = sheet.getLastRow();
    if (lastRow > 1) {
      const existing = sheet.getRange(2, 1, lastRow - 1, currentCols).getValues();
      const upgraded = existing.map(row => {
        while (row.length < HEADERS.length) row.push('');
        return row;
      });
      sheet.clearContents();
      sheet.getRange(1, 1, upgraded.length + 1, HEADERS.length).setValues([HEADERS, ...upgraded]);
    } else {
      sheet.clearContents();
      sheet.appendRow(HEADERS);
    }
  } else if (currentCols > HEADERS.length) {
    sheet.deleteColumns(HEADERS.length + 1, currentCols - HEADERS.length);
  }
  const currentHeaders = sheet.getRange(1, 1, 1, HEADERS.length).getValues()[0];
  if (JSON.stringify(currentHeaders) !== JSON.stringify(HEADERS)) {
    sheet.getRange(1, 1, 1, HEADERS.length).setValues([HEADERS]);
  }
  return sheet;
}
```

### Step 4: Deploy the Web App
1. In the upper-right corner of the Apps Script page, click the blue **Deploy** button -> **New deployment**.
2. Click the gear icon next to "Select type" and choose **Web app**.
3. Fill in the deployment details:
   * **Description**: `Census Sync Web App`
   * **Execute as**: **Me (your-email@gmail.com)** *(This is critical so the script can write to your sheet)*
   * **Who has access**: **Anyone** *(This is required so the app can contact the sheet without requiring Google sign-in)*
4. Click **Deploy**.
5. Google will ask you to **Authorize Access**. Click *Authorize Access*, choose your Google account, click *Advanced*, and select *Go to Untitled project (unsafe)*, then approve the permissions.
6. Copy the **Web App URL** provided under the Web App section (it will end with `/exec`).

---

## Step 5: Connect Your Census App to Google Sheets
1. Open your deployed Census App in the browser.
2. Click the **Settings (⚙️)** icon in the upper-right corner.
3. Set the **Sync Engine** option to **Google Sheets**.
4. Paste your copied **Web App URL** into the **Google Web App URL** input field.
5. Click **Save Settings**.
6. Now, you can click **Sync to Cloud** to push your data to the spreadsheet, or **Restore Cloud** to pull down the database onto any new device!
